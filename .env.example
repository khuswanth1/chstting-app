# ---- ChatFlow backend configuration (copy to backend/.env) ----
APP_ENV=development

# PostgreSQL (see docker-compose.yml, or install PostgreSQL locally)
DATABASE_URL=postgresql+psycopg://chatflow:chatflow@localhost:5432/chatflow

# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# The backend refuses to start with the default key when APP_ENV=production.
SECRET_KEY=dev-only-change-me-dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local media storage (served at /uploads). Use S3/MinIO for real deployments.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
STATUS_TTL_HOURS=24
# Largest amount of media included in one "Back up my data" download
BACKUP_MAX_MEDIA_MB=500

# ---- WebRTC voice/video calls ----
# STUN (free) is enough on the same network / most home NATs.
STUN_URLS=stun:stun.l.google.com:19302
# TURN relay (needed across strict NATs / mobile carriers). Run coturn yourself:
#   docker compose --profile calls up -d turn      (uses TURN_SECRET below)
# The API hands each logged-in user short-lived credentials derived from TURN_SECRET (never put it in the frontend).
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
TURN_URLS=
TURN_SECRET=
TURN_TTL_SECONDS=3600
#   e.g. TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
# Alternative: one static account from a TURN provider
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---- ChatFlow AI (assistant bot + AI tools) ----
# Any OpenAI-compatible endpoint. Default: local Ollama (free, private):  https://ollama.com
#   ollama pull llama3.2     then keep Ollama running (it serves http://localhost:11434)
AI_ENABLED=true
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=llama3.2
AI_API_KEY=
AI_TIMEOUT_SECONDS=90
AI_RATE_LIMIT_PER_MIN=20

# Allow webhooks to target localhost/private IPs (testing only - disables the SSRF guard)
ALLOW_PRIVATE_WEBHOOKS=false
